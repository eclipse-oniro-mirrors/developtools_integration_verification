// arktsid: equal_finite_values_subtract_to_positive_zero
// description: Equal finite values subtract to positive zero

function main(): void {
    arktest.assertPositiveZero(Number.MIN_VALUE - Number.MIN_VALUE);
    arktest.assertPositiveZero(-Number.MAX_VALUE - -Number.MAX_VALUE);
    arktest.assertPositiveZero((1.0 / Number.MAX_VALUE) - (1.0 / Number.MAX_VALUE));
}
