// arktsid: identifier_values_russian_lowercase_unicode_escape
// description: Russian lowercase identifiers can use four-digit Unicode escapes

function main(): void {
    let \u0430: int = 1;
    arktest.assertEQ(а, 1);
    let \u0431: int = 1;
    arktest.assertEQ(б, 1);
    let \u0432: int = 1;
    arktest.assertEQ(в, 1);
    let \u0433: int = 1;
    arktest.assertEQ(г, 1);
    let \u0434: int = 1;
    arktest.assertEQ(д, 1);
    let \u0435: int = 1;
    arktest.assertEQ(е, 1);
    let \u0436: int = 1;
    arktest.assertEQ(ж, 1);
    let \u0437: int = 1;
    arktest.assertEQ(з, 1);
    let \u0438: int = 1;
    arktest.assertEQ(и, 1);
    let \u0439: int = 1;
    arktest.assertEQ(й, 1);
    let \u043A: int = 1;
    arktest.assertEQ(к, 1);
    let \u043B: int = 1;
    arktest.assertEQ(л, 1);
    let \u043C: int = 1;
    arktest.assertEQ(м, 1);
    let \u043D: int = 1;
    arktest.assertEQ(н, 1);
    let \u043E: int = 1;
    arktest.assertEQ(о, 1);
    let \u043F: int = 1;
    arktest.assertEQ(п, 1);
    let \u0440: int = 1;
    arktest.assertEQ(р, 1);
    let \u0441: int = 1;
    arktest.assertEQ(с, 1);
    let \u0442: int = 1;
    arktest.assertEQ(т, 1);
    let \u0443: int = 1;
    arktest.assertEQ(у, 1);
    let \u0444: int = 1;
    arktest.assertEQ(ф, 1);
    let \u0445: int = 1;
    arktest.assertEQ(х, 1);
    let \u0446: int = 1;
    arktest.assertEQ(ц, 1);
    let \u0447: int = 1;
    arktest.assertEQ(ч, 1);
    let \u0448: int = 1;
    arktest.assertEQ(ш, 1);
    let \u0449: int = 1;
    arktest.assertEQ(щ, 1);
    let \u044A: int = 1;
    arktest.assertEQ(ъ, 1);
    let \u044B: int = 1;
    arktest.assertEQ(ы, 1);
    let \u044C: int = 1;
    arktest.assertEQ(ь, 1);
    let \u044D: int = 1;
    arktest.assertEQ(э, 1);
    let \u044E: int = 1;
    arktest.assertEQ(ю, 1);
    let \u044F: int = 1;
    arktest.assertEQ(я, 1);
    let \u0451: int = 1;
    arktest.assertEQ(ё, 1);
}
