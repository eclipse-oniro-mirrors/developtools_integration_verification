// arktsid: identifier_values_english_uppercase_unicode_codepoint
// description: English uppercase identifiers can use Unicode code point escapes

function main(): void {
    let \u{41}: int = 1;
    arktest.assertEQ(A, 1);
    let \u{42}: int = 1;
    arktest.assertEQ(B, 1);
    let \u{43}: int = 1;
    arktest.assertEQ(C, 1);
    let \u{44}: int = 1;
    arktest.assertEQ(D, 1);
    let \u{45}: int = 1;
    arktest.assertEQ(E, 1);
    let \u{46}: int = 1;
    arktest.assertEQ(F, 1);
    let \u{47}: int = 1;
    arktest.assertEQ(G, 1);
    let \u{48}: int = 1;
    arktest.assertEQ(H, 1);
    let \u{49}: int = 1;
    arktest.assertEQ(I, 1);
    let \u{4A}: int = 1;
    arktest.assertEQ(J, 1);
    let \u{4B}: int = 1;
    arktest.assertEQ(K, 1);
    let \u{4C}: int = 1;
    arktest.assertEQ(L, 1);
    let \u{4D}: int = 1;
    arktest.assertEQ(M, 1);
    let \u{4E}: int = 1;
    arktest.assertEQ(N, 1);
    let \u{4F}: int = 1;
    arktest.assertEQ(O, 1);
    let \u{50}: int = 1;
    arktest.assertEQ(P, 1);
    let \u{51}: int = 1;
    arktest.assertEQ(Q, 1);
    let \u{52}: int = 1;
    arktest.assertEQ(R, 1);
    let \u{53}: int = 1;
    arktest.assertEQ(S, 1);
    let \u{54}: int = 1;
    arktest.assertEQ(T, 1);
    let \u{55}: int = 1;
    arktest.assertEQ(U, 1);
    let \u{56}: int = 1;
    arktest.assertEQ(V, 1);
    let \u{57}: int = 1;
    arktest.assertEQ(W, 1);
    let \u{58}: int = 1;
    arktest.assertEQ(X, 1);
    let \u{59}: int = 1;
    arktest.assertEQ(Y, 1);
    let \u{5A}: int = 1;
    arktest.assertEQ(Z, 1);
}
