// arktsid: identifier_values_english_uppercase_unicode_escape
// description: English uppercase identifiers can use four-digit Unicode escapes

function main(): void {
    let \u0041: int = 1;
    arktest.assertEQ(A, 1);
    let \u0042: int = 1;
    arktest.assertEQ(B, 1);
    let \u0043: int = 1;
    arktest.assertEQ(C, 1);
    let \u0044: int = 1;
    arktest.assertEQ(D, 1);
    let \u0045: int = 1;
    arktest.assertEQ(E, 1);
    let \u0046: int = 1;
    arktest.assertEQ(F, 1);
    let \u0047: int = 1;
    arktest.assertEQ(G, 1);
    let \u0048: int = 1;
    arktest.assertEQ(H, 1);
    let \u0049: int = 1;
    arktest.assertEQ(I, 1);
    let \u004A: int = 1;
    arktest.assertEQ(J, 1);
    let \u004B: int = 1;
    arktest.assertEQ(K, 1);
    let \u004C: int = 1;
    arktest.assertEQ(L, 1);
    let \u004D: int = 1;
    arktest.assertEQ(M, 1);
    let \u004E: int = 1;
    arktest.assertEQ(N, 1);
    let \u004F: int = 1;
    arktest.assertEQ(O, 1);
    let \u0050: int = 1;
    arktest.assertEQ(P, 1);
    let \u0051: int = 1;
    arktest.assertEQ(Q, 1);
    let \u0052: int = 1;
    arktest.assertEQ(R, 1);
    let \u0053: int = 1;
    arktest.assertEQ(S, 1);
    let \u0054: int = 1;
    arktest.assertEQ(T, 1);
    let \u0055: int = 1;
    arktest.assertEQ(U, 1);
    let \u0056: int = 1;
    arktest.assertEQ(V, 1);
    let \u0057: int = 1;
    arktest.assertEQ(W, 1);
    let \u0058: int = 1;
    arktest.assertEQ(X, 1);
    let \u0059: int = 1;
    arktest.assertEQ(Y, 1);
    let \u005A: int = 1;
    arktest.assertEQ(Z, 1);
}
