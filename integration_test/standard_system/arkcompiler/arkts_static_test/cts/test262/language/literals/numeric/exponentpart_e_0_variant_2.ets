// arktsid: exponentpart_e_0_variant_2
// description: ExponentPart :: E 0

function main(): void {
    arktest.assertEQ(0E0, 0, '#0: 0E0 === 0');
    arktest.assertEQ(1E0, 1, '#1: 1E0 === 1');
    arktest.assertEQ(2E0, 2, '#2: 2E0 === 2');
    arktest.assertEQ(3E0, 3, '#3: 3E0 === 3');
    arktest.assertEQ(4E0, 4, '#4: 4E0 === 4');
    arktest.assertEQ(5E0, 5, '#5: 5E0 === 5');
    arktest.assertEQ(6E0, 6, '#6: 6E0 === 6');
    arktest.assertEQ(7E0, 7, '#7: 7E0 === 7');
    arktest.assertEQ(8E0, 8, '#8: 8E0 === 8');
    arktest.assertEQ(9E0, 9, '#9: 9E0 === 9');
}
