/*---
tags: [compile-only, negative]
expected_out_1: "Syntax error ESY0227: Unexpected token '/'."
---*/

let array: Int8Array = new Int8Array(10);
array[/\u007d\u00fc\u0043/] = 1.499;
arktest.assertEQ(1.499, array[/\u007d\u00fc\u0043/]);
