{
  "description": "Non-screenshot Hypium assert suites for 0803 batch",
  "environment": [
    {
      "type": "device"
    }
  ],
  "driver": {
    "type": "OHJSUnitTest",
    "bundle-name": "com.example.uiassert_01",
    "module-name": "entry",
    "test-timeout": "180000",
    "shell-timeout": "180000",
    "testcase-timeout": "60000"
  },
  "kits": [
    {
      "test-file-name": [
        "ace/resource/common/hap/uiAssertTest_01.hap"
      ],
      "type": "AppInstallKit",
      "cleanup-apps": true
    }
  ]
}
