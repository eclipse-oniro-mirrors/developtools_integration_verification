{
  "description": "Config for XtsTestCase devicetest test cases",
  "environment": [
    {
      "type": "device"
    }
  ],
  "driver": {
    "type": "DeviceTest",
    "bundle-name": "com.example.uicompare",
    "py_file": "ace/testcases/UI_Compare_Tools_Common.py"
  },
  "kits": [
    {
      "test-file-name": [
        "ace/resource/common/hap/uiCompareTest_08.hap"
      ],
      "type": "AppInstallKit",
      "cleanup-apps": true
    },
    {
      "type": "ShellKit",
      "run-command": [
        "power-shell wakeup",
        "power-shell setmode 602",
        "power-shell display -s 0"
      ]
    }
  ],
  "extra": {
    "SUB_ACE_UI_COMPONENT_TEXT_TEXT_UI_0400": [
      [
        "SUB_ACE_UI_COMPONENT_TEXT_TEXT_UI_0400.webp",
        "SUB_ACE_UI_COMPONENT_TEXT_TEXT_UI_0400.webp"
      ]
    ],
    "SUB_ACE_UI_COMPONENT_TEXT_TEXT_UI_1220": [
      [
        "SUB_ACE_UI_COMPONENT_TEXT_TEXT_UI_1220.webp",
        "SUB_ACE_UI_COMPONENT_TEXT_TEXT_UI_1220.webp"
      ]
    ],
    "SUB_ACE_UI_COMPONENT_TEXT_TEXT_UI_1310mid": [
      [
        "SUB_ACE_UI_COMPONENT_TEXT_TEXT_UI_1310mid.webp",
        "SUB_ACE_UI_COMPONENT_TEXT_TEXT_UI_1310mid.webp"
      ]
    ],
    "SUB_ACE_UI_COMPONENT_TEXT_TEXT_UI_1440mid": [
      [
        "SUB_ACE_UI_COMPONENT_TEXT_TEXT_UI_1440mid.webp",
        "SUB_ACE_UI_COMPONENT_TEXT_TEXT_UI_1440mid.webp"
      ]
    ]
  }
}
