{
  "description": "Config for XtsTestCase devicetest test cases",
  "environment": [
    {
      "type": "device"
    }
  ],
  "driver": {
    "type": "DeviceTest",
    "bundle-name": "com.example.uicompare",
    "py_file": "ace/testcases/UI_Compare_Tools_Common.py"
  },
  "kits": [
    {
      "test-file-name": [
        "ace/resource/common/hap/uiCompareTest_10.hap"
      ],
      "type": "AppInstallKit",
      "cleanup-apps": true
    },
    {
      "type": "ShellKit",
      "run-command": [
        "power-shell wakeup",
        "power-shell setmode 602",
        "power-shell display -s 0"
      ]
    }
  ],
  "extra": {}
}
