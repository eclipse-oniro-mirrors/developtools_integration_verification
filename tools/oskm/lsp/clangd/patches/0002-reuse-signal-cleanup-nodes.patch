 //===----------------------------------------------------------------------===//
 
 #include "llvm/Support/Signals.h"
+#include "llvm/Support/FileSystem.h"
+#include <thread>
+#include <vector>
 #include "llvm/ADT/ScopeExit.h"
 #include "llvm/Config/config.h"
 #include "gmock/gmock.h"
@@ -62,3 +65,59 @@
