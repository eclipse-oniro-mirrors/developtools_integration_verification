+#if defined(LLVM_ON_UNIX)
+TEST(SignalsTest, ReusedRegistrationsPreserveCleanup) {
+  SmallString<128> Removed, Kept;
+  ASSERT_FALSE(fs::createTemporaryFile("signal-removed", "tmp", Removed));
+  ASSERT_FALSE(fs::createTemporaryFile("signal-kept", "tmp", Kept));
+  auto Cleanup = make_scope_exit([&] {
+    DontRemoveFileOnSignal(Removed);
+    DontRemoveFileOnSignal(Kept);
+    fs::remove(Removed);
+    fs::remove(Kept);
+  });
+  // Repeatedly cancel and re-register a filename before running cleanup.
+  for (unsigned I = 0; I != 1000; ++I) {
+    ASSERT_FALSE(RemoveFileOnSignal(Kept));
+    DontRemoveFileOnSignal(Kept);
+  }
+  ASSERT_FALSE(RemoveFileOnSignal(Removed));
+  RunInterruptHandlers();
+  EXPECT_FALSE(fs::exists(Removed));
+  EXPECT_TRUE(fs::exists(Kept));
+
+  // Cleanup must leave empty slots reusable, and a registered file must still
+  // be removed after a previous cleanup pass.
+  ASSERT_FALSE(RemoveFileOnSignal(Kept));
+  RunInterruptHandlers();
+  EXPECT_FALSE(fs::exists(Kept));
+}
+
+#if LLVM_ENABLE_THREADS
+TEST(SignalsTest, ConcurrentRegistrationsPreserveKeptFiles) {
+  SmallString<128> Kept;
+  ASSERT_FALSE(fs::createTemporaryFile("signal-parallel-kept", "tmp", Kept));
+  auto Cleanup = make_scope_exit([&] {
+    DontRemoveFileOnSignal(Kept);
+    fs::remove(Kept);
+  });
+  std::vector<std::thread> Threads;
+  for (unsigned T = 0; T != 16; ++T)
+    Threads.emplace_back([T] {
+      std::string Name = "llvm-signal-registration-" + std::to_string(T);
+      for (unsigned I = 0; I != 1000; ++I) {
+        RemoveFileOnSignal(Name);
+        DontRemoveFileOnSignal(Name);
+      }
+    });
+  for (auto &Thread : Threads)
+    Thread.join();
+  ASSERT_FALSE(RemoveFileOnSignal(Kept));
+  DontRemoveFileOnSignal(Kept);
+  RunInterruptHandlers();
+  EXPECT_TRUE(fs::exists(Kept));
+}
+#endif
+#endif
