{
  "name": "oskm-viewer",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "shoot": "node tools/shoot.mjs",
    "test": "node --test tools/elf-graph.test.mjs",
    "perf": "node tools/perf.mjs",
    "a11y": "node tools/a11y.mjs",
    "smoke": "node tools/smoke.mjs",
    "verify": "npm test && npm run smoke && npm run menu && npm run nav && npm run table && npm run a11y && npm run a11y:light && npm run perf && npm run shoot",
    "a11y:light": "THEME=light node tools/a11y.mjs",
    "shoot:light": "THEME=light node tools/shoot.mjs",
    "menu": "node tools/menu.mjs",
    "nav": "node tools/nav.mjs",
    "table": "node tools/table.mjs"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "element-plus": "^2.14.7",
    "pinia": "^2.2.0",
    "sql.js": "^1.12.0",
    "vue": "^3.5.0",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.1.0",
    "playwright": "^1.49.1",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^5.4.0"
  }
}
