# Copy this file to .env in the same directory, then fill in local values.
# The real .env is ignored by Git and is never written to query output.
# Blue is used by default. For yellow, also set:
#   OSKM_DEFAULT_ZONE=yellow
#   OSKM_YELLOW_DB_BASE_URL=https://<yellow-archive-prefix>
# The installer requests <base-url>/<YYYYMMDD> and expects knowledge.tar.gz.
OSKM_DEFAULT_ZONE=blue
OSKM_YELLOW_DB_BASE_URL=
