# Copy this file to .env in the same directory (or to <runtime-root>/.env),
# then fill in local values. The real .env is ignored by Git and its contents
# are never written to query output.
#
# Lookup order: real environment variables > <runtime-root>/.env > this dir.
#
# OSKM_DOWNLOAD_SOURCE selects the CI used for the DB + SDK archive:
#   OPENHARMONY_CI  POST to OSKM_DOWNLOAD_ENDPOINT with the fixed component
#                   dayu600_7885_ai, then download its OBS archive URL.
#   HARMONYOS_CI    GET OSKM_DOWNLOAD_ENDPOINT/<YYYYMMDD>.
OSKM_DOWNLOAD_SOURCE=OPENHARMONY_CI
OSKM_DOWNLOAD_ENDPOINT=https://dcp.openharmony.cn/api/daily_build/build/list/component
#
# The query CLI ships INSIDE knowledge.tar.gz, next to knowledge.db:
#   knowledge.tar.gz
#     knowledge.db
#     oskm-cli.pyz            <- fixed, version-less name
#     interface/sdk-js/  interface/sdk_c/
# `bootstrap.py install` unpacks all four into <runtime-root>/. There is no
# separate CLI download endpoint.
# Resolution order, first hit wins:
#   1. $OSKM_CLI                     an explicit .pyz or source directory
#   2. <runtime-root>/oskm-cli.pyz   unpacked by `install`
#   3. a source checkout of packages/oskm/cli
# Ask the CLI itself for its version: oskm-cli.pyz --version.
# Build the pyz with: python3 cli/scripts/build_cli.py   (output: cli/dist/)
#
# bootstrap.py does NOT run queries. Once installed, query the CLI directly:
#   python3 <runtime-root>/oskm-cli.pyz --db <runtime-root>/knowledge.db arch overview
# OSKM_CLI=/absolute/path/to/oskm-cli.pyz
# OSKM_RUNTIME_ROOT=~/.oskm
