// arktsid: typedarray_reverse_returns_original_object
// description: reverse returns the same typed array instance it was called on
// Conversion notes: representative TypedArray types unrolled.

function main(): void {
    let taI32 = new Int32Array(3);
    taI32[0] = 1; taI32[1] = 2; taI32[2] = 3;
    let rI32 = taI32.reverse();
    arktest.assertTrue(rI32 === taI32, 'Int32Array reverse returns this');
    let taU8 = new Uint8Array(3);
    taU8[0] = 1; taU8[1] = 2; taU8[2] = 3;
    let rU8 = taU8.reverse();
    arktest.assertTrue(rU8 === taU8, 'Uint8Array reverse returns this');
    let taF64 = new Float64Array(3);
    taF64[0] = 1; taF64[1] = 2; taF64[2] = 3;
    let rF64 = taF64.reverse();
    arktest.assertTrue(rF64 === taF64, 'Float64Array reverse returns this');
}