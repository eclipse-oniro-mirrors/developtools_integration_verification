// arktsid: sort_stability_513_elements
// description: >
//   Stability of Array.prototype.sort for an array with 513 elements. The
//   sort is required to be stable (elements that compare equal keep their
//   original order). The length 513 was chosen because until late 2018,
//   Chakra applied an unstable QuickSort for arrays with more than 512
//   elements, although it used a stable insertion sort for anything else.
// Conversion notes:
//  - Sort comparator (a, b) => b.rating - a.rating is rewritten with
//     explicit int parameter/return types.
//  - The source verifies stability via a reduce that collapses runs of
//     equal leading name-letters into one letter, expecting
//     "DGBEFHACIJK". The same collapse is implemented here with a
//     for-loop using charAt. A second loop asserts ratings are in
//     non-increasing (descending) order.

class Item {
    public name: string;
    public rating: int;
    constructor(n: string, r: int) {
        this.name = n;
        this.rating = r;
    }
}

