    arktest.assertEQ(arr.length, 513, 'arr.length');

    // Sort by `rating` in descending order (in place).
    arr.sort((a: Item, b: Item): int => {
        return b.rating - a.rating;
    });

    // Stability check: collapse runs of equal leading name-letters.
    let reduced: string = '';
    for (let i: int = 0; i < arr.length; i++) {
        let letter: char = arr[i].name.charAt(0);
        if (reduced.length == 0 || reduced.charAt(reduced.length - 1) != letter) {
            reduced += letter;
        }
    }
    arktest.assertEQ(reduced, 'DGBEFHACIJK', 'stable letter order');

    // Ratings must be in non-increasing order.
    for (let i: int = 1; i < arr.length; i++) {
        arktest.assertTrue(arr[i].rating <= arr[i - 1].rating, 'descending rating at index ' + i.toString());
    }
