// arktsid: identifier_values_english_lowercase_unicode_escape
// description: English lowercase identifiers can use four-digit Unicode escapes

function main(): void {
    let \u0061: int = 1;
    arktest.assertEQ(a, 1);
    let \u0062: int = 1;
    arktest.assertEQ(b, 1);
    let \u0063: int = 1;
    arktest.assertEQ(c, 1);
    let \u0064: int = 1;
    arktest.assertEQ(d, 1);
    let \u0065: int = 1;
    arktest.assertEQ(e, 1);
    let \u0066: int = 1;
    arktest.assertEQ(f, 1);
    let \u0067: int = 1;
    arktest.assertEQ(g, 1);
    let \u0068: int = 1;
    arktest.assertEQ(h, 1);
    let \u0069: int = 1;
    arktest.assertEQ(i, 1);
    let \u006A: int = 1;
    arktest.assertEQ(j, 1);
    let \u006B: int = 1;
    arktest.assertEQ(k, 1);
    let \u006C: int = 1;
    arktest.assertEQ(l, 1);
    let \u006D: int = 1;
    arktest.assertEQ(m, 1);
    let \u006E: int = 1;
    arktest.assertEQ(n, 1);
    let \u006F: int = 1;
    arktest.assertEQ(o, 1);
    let \u0070: int = 1;
    arktest.assertEQ(p, 1);
    let \u0071: int = 1;
    arktest.assertEQ(q, 1);
    let \u0072: int = 1;
    arktest.assertEQ(r, 1);
    let \u0073: int = 1;
    arktest.assertEQ(s, 1);
    let \u0074: int = 1;
    arktest.assertEQ(t, 1);
    let \u0075: int = 1;
    arktest.assertEQ(u, 1);
    let \u0076: int = 1;
    arktest.assertEQ(v, 1);
    let \u0077: int = 1;
    arktest.assertEQ(w, 1);
    let \u0078: int = 1;
    arktest.assertEQ(x, 1);
    let \u0079: int = 1;
    arktest.assertEQ(y, 1);
    let \u007A: int = 1;
    arktest.assertEQ(z, 1);
}
