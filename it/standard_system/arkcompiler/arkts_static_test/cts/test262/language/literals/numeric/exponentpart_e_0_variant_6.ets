    arktest.assertEQ(3.E0, 3, '#3: 3.E0 === 3');
    arktest.assertEQ(4.E0, 4, '#4: 4.E0 === 4');
    arktest.assertEQ(5.E0, 5, '#5: 5.E0 === 5');
    arktest.assertEQ(6.E0, 6, '#6: 6.E0 === 6');
    arktest.assertEQ(7.E0, 7, '#7: 7.E0 === 7');
    arktest.assertEQ(8.E0, 8, '#8: 8.E0 === 8');
    arktest.assertEQ(9.E0, 9, '#9: 9.E0 === 9');
