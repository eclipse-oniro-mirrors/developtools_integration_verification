// arktsid: method_params_trailing_comma_single
// description: trailing comma single param
// source: method/params-trailing-comma-single.js
// Conversion notes: 源为 class 表达式（var C = class {...}），ArkTS 拒表达式（ESE0020），改 class 声明；assert.sameValue 改
// arktest.assertTrue；C.prototype.method() 改实例/类名直调。

class C {
    method(a: number,): void {
        arktest.assertTrue(a === 42);
    }
}

function main(): void {
    let c: C = new C();
    c.method(42);
}